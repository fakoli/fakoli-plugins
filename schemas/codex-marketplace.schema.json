{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "plugins"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "policy",
          "category"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "source": {
            "type": "object",
            "required": [
              "source",
              "path"
            ],
            "properties": {
              "source": {
                "const": "local"
              },
              "path": {
                "type": "string",
                "pattern": "^\\./[^\\x00]+$"
              }
            },
            "additionalProperties": false
          },
          "policy": {
            "type": "object",
            "required": [
              "installation",
              "authentication"
            ],
            "properties": {
              "installation": {
                "enum": [
                  "AVAILABLE",
                  "NOT_AVAILABLE",
                  "INSTALLED_BY_DEFAULT"
                ]
              },
              "authentication": {
                "enum": [
                  "ON_INSTALL",
                  "ON_USE"
                ]
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "interface": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
