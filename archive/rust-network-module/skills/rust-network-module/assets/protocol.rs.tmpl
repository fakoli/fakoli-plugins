//! Example wire format, not SOCKS5: version:u8 + port:u16 (network byte order).
//! Adapt the layout, bounds, and reply semantics to the actual protocol spec.
use std::io;
use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt};

pub const VERSION: u8 = 1;

#[derive(Debug, PartialEq, Eq)]
pub struct __TYPE__Request {
    pub port: u16,
}

/// Caller supplies a whole-handshake deadline. On error/cancellation, close the
/// stream: read_exact/read_u16 can consume partial input and cannot be restarted.
pub async fn parse___NAME__<R: AsyncRead + Unpin>(stream: &mut R) -> io::Result<__TYPE__Request> {
    let version = stream.read_u8().await?;
    if version != VERSION {
        return Err(io::Error::new(io::ErrorKind::InvalidData, "unsupported protocol version"));
    }
    let port = stream.read_u16().await?;
    if port == 0 {
        return Err(io::Error::new(io::ErrorKind::InvalidData, "port must be nonzero"));
    }
    Ok(__TYPE__Request { port })
}

pub async fn send_reply<W: AsyncWrite + Unpin>(stream: &mut W, status: u8) -> io::Result<()> {
    stream.write_all(&[VERSION, status]).await?;
    stream.flush().await
}
