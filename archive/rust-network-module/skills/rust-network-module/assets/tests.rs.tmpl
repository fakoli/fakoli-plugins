// Append to protocol.rs after substituting __NAME__. Uses the example wire
// format in protocol.rs.tmpl; update the bytes/assertions when adapting it.
#[cfg(test)]
mod tests {
    use super::*;
    use std::time::Duration;
    use tokio::io::{duplex, AsyncReadExt, AsyncWriteExt};
    use tokio::time::timeout;

    #[tokio::test]
    async fn valid_request_and_reply() {
        timeout(Duration::from_secs(2), async {
            let (mut client, mut server) = duplex(16);
            client.write_all(&[VERSION, 0x1f, 0x90]).await.unwrap();
            assert_eq!(parse___NAME__(&mut server).await.unwrap().port, 8080);
            send_reply(&mut server, 0).await.unwrap();
            let mut reply = [0; 2];
            client.read_exact(&mut reply).await.unwrap();
            assert_eq!(reply, [VERSION, 0]);
        }).await.expect("handshake timed out");
    }

    #[tokio::test]
    async fn rejects_wrong_version_zero_port_and_truncated_request() {
        timeout(Duration::from_secs(2), async {
            for (bytes, kind) in [
                (vec![0xff], io::ErrorKind::InvalidData),
                (vec![VERSION, 0, 0], io::ErrorKind::InvalidData),
                (vec![VERSION, 0x1f], io::ErrorKind::UnexpectedEof),
                (vec![], io::ErrorKind::UnexpectedEof),
            ] {
                let (mut client, mut server) = duplex(16);
                client.write_all(&bytes).await.unwrap();
                client.shutdown().await.unwrap();
                assert_eq!(parse___NAME__(&mut server).await.unwrap_err().kind(), kind);
            }
        }).await.expect("error cases timed out");
    }

    #[tokio::test]
    async fn fragmented_request_and_stalled_handshake() {
        timeout(Duration::from_secs(2), async {
            let (mut client, mut server) = duplex(16);
            let writer = tokio::spawn(async move {
                for byte in [VERSION, 0, 80] {
                    client.write_all(&[byte]).await.unwrap();
                    tokio::task::yield_now().await;
                }
            });
            assert_eq!(parse___NAME__(&mut server).await.unwrap().port, 80);
            writer.await.unwrap();
            let (_client, mut stalled) = duplex(16);
            assert!(timeout(Duration::from_millis(20), parse___NAME__(&mut stalled)).await.is_err());
        }).await.expect("fragmentation test timed out");
    }

    #[tokio::test]
    async fn reply_propagates_closed_writer_error() {
        let (mut server, client) = duplex(16);
        drop(client);
        assert!(timeout(Duration::from_secs(2), send_reply(&mut server, 0)).await.unwrap().is_err());
    }
}
